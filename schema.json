{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorktreeConfig",
  "description": "Configuration for the worktree manager.\n\nJSON keys use camelCase. Unknown legacy fields are ignored when loading and omitted when saving.",
  "type": "object",
  "properties": {
    "dashboard": {
      "description": "Live dashboard preferences.",
      "default": {
        "columns": [
          "branch",
          "from",
          "status",
          "ahead_behind",
          "last_commit"
        ],
        "refreshIntervalMs": 5000,
        "showPullRequests": false
      },
      "allOf": [
        {
          "$ref": "#/definitions/DashboardConfig"
        }
      ]
    },
    "deleteBranchWithWorktree": {
      "description": "Also delete the associated git branch when deleting a worktree.",
      "default": false,
      "type": "boolean"
    },
    "globalDashboard": {
      "description": "Stored only in the global config; project saves omit this field.",
      "anyOf": [
        {
          "$ref": "#/definitions/GlobalDashboardConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "postCreateCmd": {
      "description": "Commands to run after creating a worktree. Variables: $BASE_PATH, $WORKTREE_PATH, $BRANCH_NAME, $SOURCE_BRANCH.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "terminalCommand": {
      "description": "Command to open terminal in new worktree directory (e.g., 'code $WORKTREE_PATH').",
      "default": "",
      "type": "string"
    },
    "worktreeCopyIgnores": {
      "description": "File patterns to ignore when copying (glob patterns supported).",
      "default": [
        "**/node_modules/**",
        "**/dist/**",
        "**/.git/**",
        "**/Thumbs.db",
        "**/.DS_Store"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worktreeCopyPatterns": {
      "description": "File patterns to copy to new worktrees (glob patterns supported).",
      "default": [
        ".env*",
        ".vscode/**"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worktreeLinkPatterns": {
      "description": "File and directory patterns to symlink directly to the Mother worktree.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worktreePathTemplate": {
      "description": "Template for worktree directory names. Variables: $BASE_PATH, $WORKTREE_PATH, $BRANCH_NAME, $SOURCE_BRANCH.",
      "default": "$BASE_PATH.worktree",
      "type": "string"
    }
  },
  "definitions": {
    "DashboardConfig": {
      "type": "object",
      "properties": {
        "columns": {
          "default": [
            "branch",
            "from",
            "status",
            "ahead_behind",
            "last_commit"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refreshIntervalMs": {
          "default": 5000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "showPullRequests": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "DashboardFilter": {
      "description": "OR of AND groups. No groups means show everything.",
      "type": "object",
      "required": [
        "groups"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DashboardFilterGroup"
          }
        }
      },
      "additionalProperties": false
    },
    "DashboardFilterField": {
      "description": "The available Global Dashboard filter fields, including compound columns.",
      "type": "string",
      "enum": [
        "profile",
        "repository",
        "location",
        "status",
        "checks",
        "review",
        "mergeability",
        "worktree",
        "branch",
        "from",
        "lastCommit",
        "prTitle",
        "ahead",
        "behind",
        "insertions",
        "deletions",
        "prNumber"
      ]
    },
    "DashboardFilterGroup": {
      "type": "object",
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DashboardFilterRule"
          }
        }
      },
      "additionalProperties": false
    },
    "DashboardFilterOperator": {
      "type": "string",
      "enum": [
        "isAnyOf",
        "isNoneOf",
        "contains",
        "doesNotContain",
        "is",
        "isNot",
        "equal",
        "notEqual",
        "greaterThan",
        "greaterThanOrEqual",
        "lessThan",
        "lessThanOrEqual"
      ]
    },
    "DashboardFilterRule": {
      "type": "object",
      "required": [
        "field",
        "operator",
        "values"
      ],
      "properties": {
        "field": {
          "$ref": "#/definitions/DashboardFilterField"
        },
        "operator": {
          "$ref": "#/definitions/DashboardFilterOperator"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "GlobalDashboardConfig": {
      "description": "Global Dashboard account selection, independent of project configuration.",
      "type": "object",
      "properties": {
        "filter": {
          "default": {
            "groups": [
              {
                "rules": [
                  {
                    "field": "status",
                    "operator": "isNoneOf",
                    "values": [
                      "Mother"
                    ]
                  }
                ]
              }
            ]
          },
          "allOf": [
            {
              "$ref": "#/definitions/DashboardFilter"
            }
          ]
        },
        "selectedAccounts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
