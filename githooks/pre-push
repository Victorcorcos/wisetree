#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# `git push` sets GIT_DIR (and friends) for hooks. If we leave them in
# the environment, every git invocation in our subprocesses — including
# the cli_e2e tests' `git init` / `git commit` calls in tempdirs —
# resolves to *this* repo and silently commits into our history. Strip
# them so the tests get a clean shell.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_PREFIX GIT_NAMESPACE GIT_QUARANTINE_PATH GIT_EXEC_PATH \
      GIT_INTERNAL_GETTEXT_SH_SCHEME

run_fix() {
  local name="$1"
  shift

  printf 'pre-push: applying %s\n' "$name"

  if ! "$@"; then
    printf '\nwarning: push blocked because `%s` failed.\n' "$name" >&2
    printf 'warning: resolve the reported issue locally, then push again.\n' >&2
    exit 1
  fi
}

# Apply the local autofix equivalents for CI checks where they exist.
#
# CI step                            Local autofix
# cargo fmt --all -- --check         cargo fmt --all
# cargo clippy ... -D warnings       cargo clippy --fix ...
# cargo build --all-targets          cargo fix --all-targets --all-features
# cargo test --all-features          no automatic fix available
run_fix \
  "cargo fix --all-targets --all-features" \
  cargo fix --all-targets --all-features --allow-dirty --allow-staged

run_fix \
  "cargo clippy --fix --all-targets --all-features" \
  cargo clippy --fix --all-targets --all-features --allow-dirty --allow-staged

run_fix "cargo fmt --all" cargo fmt --all

if ! git diff --quiet; then
  printf 'pre-push: committing auto-formatted changes\n'
  git add -u
  git commit -m "chore: auto-format and fix (cargo fmt + clippy)"
fi
