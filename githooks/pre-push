#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# `git push` sets GIT_DIR (and friends) for hooks. If we leave them in
# the environment, every git invocation in our subprocesses — including
# the cli_e2e tests' `git init` / `git commit` calls in tempdirs —
# resolves to this repo and silently commits into our history.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY

run_check() {
  local name="$1"
  shift

  printf 'pre-push: checking %s\n' "$name"

  if ! "$@"; then
    printf '\nwarning: push blocked because `%s` failed.\n' "$name" >&2
    printf 'warning: resolve the reported issue locally, commit it, then push again.\n' >&2
    exit 1
  fi
}

run_check "cargo fmt --all -- --check" cargo fmt --all -- --check
run_check \
  "cargo clippy --all-targets --all-features -- -D warnings" \
  cargo clippy --all-targets --all-features -- -D warnings
run_check "cargo build --all-targets" cargo build --all-targets
run_check "cargo test --all-features" cargo test --all-features
