#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# `git push` sets GIT_DIR (and friends) for hooks. If we leave them in
# the environment, every git invocation in our subprocesses — including
# the cli_e2e tests' `git init` / `git commit` calls in tempdirs —
# resolves to *this* repo and silently commits into our history. Strip
# them so the tests get a clean shell.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_PREFIX GIT_NAMESPACE GIT_QUARANTINE_PATH GIT_EXEC_PATH \
      GIT_INTERNAL_GETTEXT_SH_SCHEME

run_check() {
  local name="$1"
  shift

  printf 'pre-push: running %s\n' "$name"

  if ! "$@"; then
    printf '\nwarning: push blocked because `%s` failed.\n' "$name" >&2
    printf 'warning: fix the reported offenses locally, then push again.\n' >&2
    exit 1
  fi
}

# Mirror the checks defined in .github/workflows/ci.yml.
run_check "cargo fmt --all -- --check" cargo fmt --all -- --check
run_check "cargo clippy --all-targets --all-features -- -D warnings" cargo clippy --all-targets --all-features -- -D warnings
run_check "cargo build --all-targets" cargo build --all-targets
run_check "cargo test --all-features" cargo test --all-features
